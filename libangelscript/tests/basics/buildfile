import libs = libangelscript%lib{angelscript}

# Smoke test.
#
./: exe{driver}:
{
  test = true
  install = false
}
exe{driver}: cxx{driver} $libs

# Benign unused parameter in the upstream public header (see asSMethodPtr in
# angelscript.h).
#
if ($cxx.class == 'gcc')
  cxx.coptions += -Wno-unused-parameter
